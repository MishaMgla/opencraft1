# opencraft1 engine (server). Local dev needs none of these — defaults are
# dev-friendly. Railway sets PORT automatically.

# Port the engine listens on. Default 8080.
PORT=8080

# Comma-separated WebSocket origin allowlist (host patterns). Empty = allow all
# (local dev). In production set to the Vercel client domain(s), e.g.
# opencraft1.vercel.app or *.vercel.app
ALLOWED_ORIGINS=

# Isolated preview only: explicit opt-in, NEVER falls back to DATABASE_URL.
# Requires the dedicated opencraft_preview database + role and either loopback
# or the exact explicitly configured private Railway host below.
# PREVIEW_DATABASE_URL=postgresql://opencraft_preview:REPLACE_ME@127.0.0.1:55432/opencraft_preview?sslmode=disable
# Hosted world: exact private database host and HTTPS origin; no shared password.
# No wildcard database hosts or forwarded-host/proto trust.
# PREVIEW_DATABASE_HOST=evolving-preview-db.railway.internal
# PREVIEW_PUBLIC_ORIGIN=https://opencraft1.com

# Postgres connection string for player-position persistence (Supabase). Unset
# = persistence disabled, engine runs in-memory only (the local dev default).
# Use Supabase's SESSION POOLER (Supavisor, port 5432): it is IPv4-compatible
# (the direct db.<ref>.supabase.co endpoint is IPv6-only without the paid add-on,
# which many hosts can't reach) and, unlike the transaction pooler (6543),
# supports persistent connections + prepared statements — so pgx works unchanged.
# Get it from the dashboard "Connect" button -> Session pooler. Set in Railway.
# DATABASE_URL=postgresql://postgres.yewdvlscipamycxdosui:[PASSWORD]@aws-X-eu-north-1.pooler.supabase.com:5432/postgres

# OpenRouter API key for AI graphics generation (agents + local tooling). Set
# in .env.local locally, and in the runner/CI + Railway env for deployed use.
# OPENROUTER_API_KEY=sk-or-v1-...

# --- client (Vercel) ---
# Set in the Vercel project dashboard, NOT in this server env. WS_URL is the
# wss:// engine endpoint the /config.json function returns, e.g.
#   wss://opencraft1-engine.up.railway.app/ws
# WS_URL=

# Mobile build-time only: exact shared HTTPS origin, no trailing slash/path.
# Bundled in the app; not a secret. Defaults to https://opencraft1.com.
# OPENCRAFT_MOBILE_ORIGIN=https://opencraft1.com
